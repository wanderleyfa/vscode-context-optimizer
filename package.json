{
  "name": "context-optimizer",
  "displayName": "AI Context Optimizer",
  "description": "%extension.description%",
  "version": "0.4.0",
  "publisher": "WanderleyFerreiradeAlbuquerque",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/wanderleyfa/vscode-context-optimizer"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "copilot",
    "context",
    "optimization",
    "tokens",
    "AI",
    "instructions",
    "claude",
    "gemini",
    "cursor",
    "windsurf",
    "cline",
    "aider",
    "cody",
    "roocode",
    "kilocode"
  ],
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:.github/copilot-instructions.md",
    "workspaceContains:CLAUDE.md",
    "workspaceContains:AGENTS.md",
    "workspaceContains:.cursorrules",
    "onLanguageModelTool:context-optimizer_audit",
    "onLanguageModelTool:context-optimizer_init",
    "onLanguageModelTool:context-optimizer_apply",
    "onLanguageModelTool:context-optimizer_sync",
    "onChatParticipant:context-optimizer.agent"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "contextOptimizer.showAuditReport",
        "title": "%command.showAuditReport%"
      },
      {
        "command": "contextOptimizer.initInstructions",
        "title": "%command.initInstructions%"
      },
      {
        "command": "contextOptimizer.syncTools",
        "title": "%command.syncTools%"
      }
    ],
    "configuration": {
      "title": "AI Context Optimizer",
      "properties": {
        "contextOptimizer.autoLoadedLineThreshold": {
          "type": "number",
          "default": 80,
          "minimum": 10,
          "maximum": 500,
          "description": "%config.threshold%"
        },
        "contextOptimizer.maxFilesPerPattern": {
          "type": "number",
          "default": 1000,
          "minimum": 50,
          "maximum": 10000,
          "description": "%config.maxFiles%"
        },
        "contextOptimizer.excludeGlob": {
          "type": "string",
          "default": "**/{node_modules,dist,build,.git,.next,.turbo,.pnpm-store}/**",
          "description": "%config.excludeGlob%"
        }
      }
    },
    "languageModelTools": [
      {
        "name": "context-optimizer_audit",
        "displayName": "%tool.audit.displayName%",
        "modelDescription": "Scans the workspace for AI context files across 17+ tools (Copilot, Claude Code, Gemini, Cursor, Windsurf, Roo Code, Kilo Code, MCP, etc.), classifies their token cost (HIGH/MEDIUM/LOW/FREE), detects duplicate content similarity and lint issues, and returns an audit report plus optional HIGH/MEDIUM file contents.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "contextAudit",
        "icon": "$(sparkle)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "includeContents": {
              "type": "boolean",
              "description": "Include truncated contents of HIGH and MEDIUM cost files so the model can propose optimizations (default: true)."
            },
            "threshold": {
              "type": "number",
              "description": "Custom auto-loaded line threshold override."
            }
          }
        }
      },
      {
        "name": "context-optimizer_init",
        "displayName": "%tool.init.displayName%",
        "modelDescription": "Scaffolds a concise, token-efficient .github/copilot-instructions.md file from project metadata (package.json, pyproject.toml, Cargo.toml, go.mod).",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "contextInit",
        "icon": "$(new-file)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "writeIfMissing": {
              "type": "boolean",
              "description": "Write .github/copilot-instructions.md to disk if it does not exist yet (default: false)."
            }
          }
        }
      },
      {
        "name": "context-optimizer_apply",
        "displayName": "%tool.apply.displayName%",
        "modelDescription": "Previews unified diffs and line/token deltas for optimized AI context files (when confirm is false or omitted), or writes the previewed changes to disk with hash conflict protection (when confirm is true).",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "contextApply",
        "icon": "$(diff)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "summary": {
              "type": "string",
              "description": "Short summary of the optimization plan."
            },
            "files": {
              "type": "array",
              "description": "List of relative file paths and their full optimized contents (max 8 files).",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "description": "Safe workspace-relative path (e.g. .github/copilot-instructions.md)."
                  },
                  "content": {
                    "type": "string",
                    "description": "Complete optimized content for the file."
                  },
                  "reason": {
                    "type": "string",
                    "description": "Short explanation of why this file is created or updated."
                  }
                },
                "required": [
                  "path",
                  "content"
                ]
              }
            },
            "confirm": {
              "type": "boolean",
              "description": "Set false (default) to generate a diff preview first; set true only after explicit user confirmation to write files."
            }
          }
        }
      },
      {
        "name": "context-optimizer_sync",
        "displayName": "%tool.sync.displayName%",
        "modelDescription": "Consolidates shared instructions across AGENTS.md, .github/copilot-instructions.md, CLAUDE.md (using @AGENTS.md pointer), and .gemini/GEMINI.md with two-step diff preview and confirmation.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "contextSync",
        "icon": "$(sync)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "confirm": {
              "type": "boolean",
              "description": "Set false (default) to generate a synchronization diff preview first; set true after user confirmation to write files."
            }
          }
        }
      }
    ],
    "chatAgents": [
      {
        "path": "./agents/context-optimizer.agent.md"
      }
    ],
    "chatSkills": [
      {
        "path": "./skills/context-audit/SKILL.md"
      },
      {
        "path": "./skills/context-optimize/SKILL.md"
      },
      {
        "path": "./skills/context-compare/SKILL.md"
      },
      {
        "path": "./skills/context-apply/SKILL.md"
      },
      {
        "path": "./skills/context-sync/SKILL.md"
      },
      {
        "path": "./skills/context-init/SKILL.md"
      },
      {
        "path": "./skills/context-help/SKILL.md"
      }
    ],
    "chatParticipants": [
      {
        "id": "context-optimizer.agent",
        "fullName": "Context Optimizer",
        "name": "context-optimizer",
        "description": "%participant.description%",
        "isSticky": true,
        "commands": [
          {
            "name": "audit",
            "description": "%cmd.audit%"
          },
          {
            "name": "optimize",
            "description": "%cmd.optimize%"
          },
          {
            "name": "compare",
            "description": "%cmd.compare%"
          },
          {
            "name": "apply",
            "description": "%cmd.apply%"
          },
          {
            "name": "sync",
            "description": "%cmd.sync%"
          },
          {
            "name": "help",
            "description": "%cmd.help%"
          },
          {
            "name": "init",
            "description": "%cmd.init%"
          }
        ]
      }
    ]
  },
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "npx tsx --test src/test/*.test.ts",
    "lint": "eslint src/",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.100.0",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.0.3",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0"
  }
}
